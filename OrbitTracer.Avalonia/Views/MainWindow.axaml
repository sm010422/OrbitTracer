<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrbitTracer.ViewModels"
        x:Class="OrbitTracer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OrbitTracer — Satellite Orbit Monitor"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#1A1A2E">

    <Window.Styles>
        <!-- Default text color -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <!-- Action button (dark blue) -->
        <Style Selector="Button.action">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1a4a80"/>
        </Style>
        <Style Selector="Button.action:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Highlight button (red accent) -->
        <Style Selector="Button.highlight">
            <Setter Property="Background" Value="#E94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.highlight:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#c73050"/>
        </Style>
        <Style Selector="Button.highlight:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- ListBox item styles (CSS-like selectors replace WPF ItemContainerStyle triggers) -->
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#40E94560"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#200F3460"/>
        </Style>

        <!-- DataGrid header / cell styles -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Background" Value="#40E94560"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#0F3460" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OrbitTracer" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="  |  Satellite Orbit Tracker" FontSize="14"
                               Foreground="#8A8A9A" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
                <TextBlock Grid.Column="1" FontSize="13" Foreground="#8A8A9A" VerticalAlignment="Center"
                           Text="{Binding CurrentTime, StringFormat='Local  \{0:yyyy-MM-dd HH:mm:ss\}'}"/>
            </Grid>
        </Border>

        <!-- ── Main Content ── -->
        <Grid Grid.Row="1" ColumnDefinitions="300,4,*">

            <!-- ── Left Panel ── -->
            <Border Grid.Column="0" Background="#16213E">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Left toolbar -->
                    <Border Grid.Row="0" Background="#0F3460" Padding="8,6">
                        <WrapPanel>
                            <Button Content="ISS 가져오기" Classes="action" Margin="2"
                                    Command="{Binding FetchTLECommand}"/>
                            <Button Content="TLE 파일 열기" Classes="action" Margin="2"
                                    Click="OnOpenFileClick"/>
                        </WrapPanel>
                    </Border>

                    <!-- Satellite list -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Satellites}"
                             SelectedItem="{Binding SelectedSatellite}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SatelliteViewModel">
                                <Border Padding="8,6" Margin="0,1">
                                    <Grid ColumnDefinitions="10,*">
                                        <!-- Visibility indicator — color string binds directly in Avalonia -->
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding StatusColor}"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding PositionStr}"
                                                       FontSize="10" Foreground="#8A8A9A"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Ground station selector -->
                    <Border Grid.Row="2" Background="#0F3460" Padding="8,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ground Station"
                                       FontSize="11" Foreground="#8A8A9A"/>
                            <!-- Avalonia: DisplayMemberBinding (not DisplayMemberPath) -->
                            <ComboBox ItemsSource="{Binding GroundStations}"
                                      SelectedItem="{Binding SelectedGroundStation}"
                                      DisplayMemberBinding="{Binding Name}"
                                      Background="#16213E"
                                      Foreground="#E0E0E0"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Background="#0F3460" ResizeDirection="Columns"/>

            <!-- ── Right Panel ── -->
            <Grid Grid.Column="2" RowDefinitions="*,4,280">

                <!-- World map / satellite track area -->
                <Border Grid.Row="0" Background="#0A0A1A">
                    <Grid>
                        <!-- MapCanvas drawn in code-behind (same Canvas.SetLeft/Top API as WPF) -->
                        <Canvas x:Name="MapCanvas" ClipToBounds="True"/>

                        <TextBlock Text="World Map — Satellite Positions"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,8" FontSize="11" Foreground="#8A8A9A"/>

                        <!-- Selected satellite info overlay -->
                        <!-- Avalonia: bind IsVisible directly to bool — no converter needed -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="12" Padding="12,8"
                                Background="#CC1A1A2E" CornerRadius="4"
                                IsVisible="{Binding HasSelection}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedSatellite.Name}"
                                           FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding SelectedSatellite.PositionStr}"
                                           FontSize="12" Foreground="#8A8A9A"/>
                                <Separator Background="#0F3460" Margin="0,2"/>
                                <TextBlock Text="{Binding SelectedSatellite.LookStr}"
                                           FontSize="12" Foreground="#00FF88"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" Background="#0F3460" ResizeDirection="Rows"/>

                <!-- Pass Prediction Panel -->
                <Border Grid.Row="2" Background="#16213E" Padding="8">
                    <Grid RowDefinitions="Auto,*">

                        <!-- Pass panel header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="Pass Predictions"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="GS:" FontSize="12" Foreground="#8A8A9A"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedGroundStation.Name}"
                                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Content="위성 제거" Classes="action"
                                        Command="{Binding RemoveSatelliteCommand}"/>
                                <Button Content="패스 예측 (48h)" Classes="highlight"
                                        Command="{Binding PredictPassesCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Passes DataGrid -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Passes}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Satellite"
                                                    Binding="{Binding SatelliteName}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="AOS (Local)"
                                                    Binding="{Binding AosTime, StringFormat='HH:mm:ss'}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="LOS (Local)"
                                                    Binding="{Binding LosTime, StringFormat='HH:mm:ss'}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Duration"
                                                    Binding="{Binding DurationStr}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Max El."
                                                    Binding="{Binding MaxElevStr}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="AOS Az."
                                                    Binding="{Binding AosAzStr}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="LOS Az."
                                                    Binding="{Binding LosAzStr}"
                                                    Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Status Bar ── -->
        <Border Grid.Row="2" Background="#0F3460" Padding="12,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                    <TextBlock Text="{Binding Satellites.Count}"
                               FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text=" satellites  |  " FontSize="12" Foreground="#8A8A9A"/>
                    <TextBlock Text="{Binding SelectedGroundStation.Name}" FontSize="12"/>
                    <TextBlock Text=" (GS)" FontSize="12" Foreground="#8A8A9A"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
