<Window x:Class="OrbitTracer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrbitTracer.ViewModels"
        Title="OrbitTracer — Satellite Orbit Monitor"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OrbitTracer" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="  |  Satellite Orbit Tracker" FontSize="14"
                               Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>

                <TextBlock Grid.Column="1" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentTime, StringFormat='Local  {0:yyyy-MM-dd HH:mm:ss}'}"/>
            </Grid>
        </Border>

        <!-- ── Main Content ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Panel ── -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Left toolbar -->
                    <Border Background="{StaticResource AccentBrush}" Padding="8,6">
                        <WrapPanel>
                            <Button Content="Fetch ISS" Margin="2"
                                    Command="{Binding LoadDefaultTLECommand}"
                                    Style="{StaticResource ActionButton}"/>
                            <Button Content="Open TLE File" Margin="2"
                                    Command="{Binding LoadTLEFileCommand}"
                                    Style="{StaticResource ActionButton}"/>
                            <Button Content="Remove" Margin="2"
                                    Command="{Binding RemoveSatelliteCommand}"
                                    Style="{StaticResource ActionButton}"/>
                        </WrapPanel>
                    </Border>

                    <!-- Satellite list -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Satellites}"
                             SelectedItem="{Binding SelectedSatellite}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Visibility indicator -->
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Gray"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                            <Setter Property="Fill" Value="#FF00FF88"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding PositionStr}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SubTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#40E94560"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#200F3460"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Ground station selector -->
                    <Border Grid.Row="2" Background="{StaticResource AccentBrush}" Padding="8,8">
                        <StackPanel>
                            <TextBlock Text="Ground Station"
                                       FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding GroundStations}"
                                      SelectedItem="{Binding SelectedGroundStation}"
                                      DisplayMemberPath="Name"
                                      Background="{StaticResource PanelBrush}"
                                      Foreground="{StaticResource TextBrush}"
                                      BorderBrush="{StaticResource HighlightBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentBrush}"/>

            <!-- ── Right Panel ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="280"/>
                </Grid.RowDefinitions>

                <!-- World map / satellite track area -->
                <Border Grid.Row="0" Background="#FF0A0A1A">
                    <Grid>
                        <Canvas x:Name="MapCanvas" ClipToBounds="True"
                                SizeChanged="MapCanvas_SizeChanged"/>

                        <TextBlock Text="World Map — Satellite Positions"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,8"
                                   FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}"/>

                        <!-- Selected satellite info overlay -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="12" Padding="12,8"
                                Background="#CC1A1A2E" CornerRadius="4"
                                Visibility="{Binding HasSelection,
                                             Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedSatellite.Name}"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding SelectedSatellite.PositionStr}"
                                           FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}"
                                           Margin="0,4,0,0"/>
                                <Separator Margin="0,6"
                                           Background="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding SelectedSatellite.LookStr}"
                                           FontSize="12"
                                           Foreground="#FF00FF88"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource AccentBrush}"/>

                <!-- Pass Prediction Panel -->
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pass panel header -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Pass Predictions"
                                           FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,16,0"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="GS: "
                                           FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedGroundStation.Name}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Predict Passes (48h)"
                                    Command="{Binding PredictPassesCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Background="{StaticResource HighlightBrush}"/>
                        </Grid>

                        <!-- Passes DataGrid -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Passes}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#20FFFFFF"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="#08FFFFFF"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Padding"    Value="8,4"/>
                                    <Setter Property="FontSize"   Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="8,3"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#40E94560"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Satellite"
                                                    Binding="{Binding SatelliteName}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="AOS (Local)"
                                                    Binding="{Binding AosTime, StringFormat='HH:mm:ss'}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="LOS (Local)"
                                                    Binding="{Binding LosTime, StringFormat='HH:mm:ss'}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Duration"
                                                    Binding="{Binding DurationStr}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Max El."
                                                    Binding="{Binding MaxElevStr}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="AOS Az."
                                                    Binding="{Binding AosAzStr}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="LOS Az."
                                                    Binding="{Binding LosAzStr}"
                                                    Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Status Bar ── -->
        <Border Grid.Row="2" Background="{StaticResource AccentBrush}" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Satellites.Count}"
                               FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text=" satellites  |  "
                               FontSize="12"
                               Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="{Binding SelectedGroundStation.Name}"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text=" (GS)"
                               FontSize="12"
                               Foreground="{StaticResource SubTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
