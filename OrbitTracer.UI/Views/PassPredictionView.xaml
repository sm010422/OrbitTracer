<UserControl x:Class="OrbitTracer.Views.PassPredictionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OrbitTracer.ViewModels">

    <UserControl.DataContext>
        <vm:PassPredictionViewModel/>
    </UserControl.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Settings row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Min Elevation:"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SubTextBrush}"
                       Margin="0,0,6,0"/>
            <TextBox Text="{Binding MinElevation, UpdateSourceTrigger=PropertyChanged}"
                     Width="50"
                     Background="{StaticResource PanelBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource AccentBrush}"
                     Padding="4,2"/>
            <TextBlock Text="deg   Duration (h):"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SubTextBrush}"
                       Margin="12,0,6,0"/>
            <TextBox Text="{Binding DurationHours, UpdateSourceTrigger=PropertyChanged}"
                     Width="50"
                     Background="{StaticResource PanelBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource AccentBrush}"
                     Padding="4,2"/>
        </StackPanel>

        <!-- Pass list -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Passes}"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource TextBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,6" Margin="0,1" CornerRadius="3"
                            Background="{StaticResource AccentBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SatelliteName}"
                                           FontWeight="Bold" FontSize="12"/>
                                <TextBlock FontSize="10"
                                           Foreground="{StaticResource SubTextBrush}">
                                    <Run Text="AOS: "/>
                                    <Run Text="{Binding AosTime, StringFormat='HH:mm:ss'}"/>
                                    <Run Text="  LOS: "/>
                                    <Run Text="{Binding LosTime, StringFormat='HH:mm:ss'}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MaxElevStr}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#FF00FF88"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Max El."
                                           FontSize="9"
                                           Foreground="{StaticResource SubTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DurationStr}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Duration"
                                           FontSize="9"
                                           Foreground="{StaticResource SubTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SubTextBrush}">
                                    <Run Text="AOS az: "/>
                                    <Run Text="{Binding AosAzStr}"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="{StaticResource SubTextBrush}">
                                    <Run Text="LOS az: "/>
                                    <Run Text="{Binding LosAzStr}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
